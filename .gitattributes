# Automatically detect text files and normalize to LF
* text=auto

# Always use LF for source code and configuration
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

# Windows batch files use CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf